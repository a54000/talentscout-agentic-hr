# AI screening was removed from the ATS (2026-11-28); CVs are parsed locally.
# CLOUD_AI_FOR_CANDIDATE_DATA stays "off" on the live ATS (R-11 / BR-4).
CLOUD_AI_FOR_CANDIDATE_DATA=off

# JD/CV text extraction: "deterministic" (default) or "local" (Ollama on this machine)
PARSE_LLM_PROVIDER=deterministic

# --- Core (required) ---
SECRET_KEY=change-me-long-random-string
ADMIN_PASSWORD=change-me-first-admin-password
# DATABASE_URL is set by docker-compose from ATS_DB_PASSWORD in the root .env
PUBLIC_BASE_URL=https://ats.hrgp.in
PREFERRED_URL_SCHEME=https

# --- Google login (optional; redirect URI must match the Google console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ats.hrgp.in/login/callback
GOOGLE_OAUTH_SCOPE=openid email profile

# --- Central email sender (optional) ---
GMAIL_USER=
GMAIL_APP_PASS=

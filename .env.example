# Copy to .env (git-ignored). Never commit real values.
# --- API ---
NODE_ENV=development
LOG_LEVEL=info
# --- Agent service ---
AGENTS_ENV=development
# --- HR Guru ATS database (used by docker-compose) ---
ATS_DB_PASSWORD=change-me-local-db-password
# Cloudflare Tunnel token for ats.hrgp.in (Zero Trust -> Networks -> Tunnels). Secret: never commit.
CLOUDFLARE_TUNNEL_TOKEN=
AGENTS_SERVICE_TOKEN=change-me-to-a-long-random-string
AGENTS_LOCAL_MODEL=qwen3:8b
AGENTS_EMBEDDING_MODEL=nomic-embed-text
# --- Data ---
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
REDIS_URL=redis://localhost:6379
# --- Free-tier cloud LLMs (synthetic/masked data ONLY - see ADR-0004) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# --- Observability (Langfuse Cloud Hobby) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
